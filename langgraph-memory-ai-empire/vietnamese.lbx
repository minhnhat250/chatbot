\ProvidesFile{vietnamese.lbx}
  [2026/07/24 v1.0 Vietnamese localization for AI Empire bibliography]

\InheritBibliographyExtras{english}
\DeclareBibliographyExtras{%
  \def\finalandcomma{}%
  \protected\def\mkbibordinal#1{#1}%
  \protected\def\mkbibmascord{\mkbibordinal}%
  \protected\def\mkbibfemord{\mkbibordinal}%
  \protected\def\mkbibneutord{\mkbibordinal}%
  \protected\def\mkbibdateshort#1#2#3{%
    \iffieldundef{#3}
      {}
      {\mkdayzeros{\thefield{#3}}%
       \iffieldundef{#2}
         {\iffieldundef{#1}{}{\bibdatesep}}
         {/}}%
    \iffieldundef{#2}
      {}
      {\mkmonthzeros{\thefield{#2}}%
       \iffieldundef{#1}{}{\bibdatesep}}%
    \iffieldundef{#1}
      {}
      {\dateeraprintpre{#1}\mkyearzeros{\thefield{#1}}}}%
}
\DeclareBibliographyStrings{inherit={english}}

\DeclareBibliographyStrings{%
  bibliography = {{Tài liệu tham khảo}{Tài liệu tham khảo}},
  references   = {{Tài liệu tham khảo}{Tài liệu tham khảo}},
  and          = {{và}{và}},
  andothers    = {{và cộng sự}{và cộng sự}},
  editor       = {{biên tập viên}{b.t.v.}},
  editors      = {{các biên tập viên}{các b.t.v.}},
  edition      = {{ấn bản}{ấn bản}},
  volume       = {{tập}{tập}},
  volumes      = {{các tập}{các tập}},
  number       = {{số}{số}},
  page         = {{trang}{trang}},
  pages        = {{trang}{trang}},
  in           = {{trong}{trong}},
  urlseen      = {{truy cập ngày}{truy cập ngày}},
  mathesis     = {{luận văn thạc sĩ}{luận văn thạc sĩ}},
  phdthesis    = {{luận án tiến sĩ}{luận án tiến sĩ}},
}

\endinput
