<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:TPM="http://texlive.dante.de/"><rdf:Description about="http://www.miktex.org/packages/needspace"><TPM:Name>needspace</TPM:Name><TPM:Creator>mpc</TPM:Creator><TPM:Title>Insert pagebreak if not enough space</TPM:Title><TPM:Version>1.3e</TPM:Version><TPM:TargetSystem minVersion=""></TPM:TargetSystem><TPM:Description>Provides commands to disable pagebreaking within a given vertical space. If there is not enough space between the command and the bottom of the page, a new page will be started.</TPM:Description><TPM:RunFiles size="1297">texmf\tex\latex\needspace\needspace.sty</TPM:RunFiles><TPM:TimePackaged>1742731462</TPM:TimePackaged><TPM:MD5>8a113cb6cbe0d4dac89286f79f78a48c</TPM:MD5><TPM:CTAN path="/macros/latex/contrib/needspace"/><TPM:Copyright owner="Peter Wilson" year="1996-2003"/><TPM:License type="lppl1.3c"/></rdf:Description></rdf:RDF>