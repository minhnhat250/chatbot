<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:TPM="http://texlive.dante.de/"><rdf:Description about="http://www.miktex.org/packages/eso-pic"><TPM:Name>eso-pic</TPM:Name><TPM:Creator>mpc</TPM:Creator><TPM:Title>Add picture commands (or backgrounds) to every page</TPM:Title><TPM:Version>3.0e</TPM:Version><TPM:TargetSystem minVersion=""></TPM:TargetSystem><TPM:Description>The package adds one or more user commands to LaTeX’s shipout routine, which may be used to place the output at fixed positions. The grid option may be used to find the correct places.</TPM:Description><TPM:RunFiles size="14177">texmf\tex\latex\eso-pic\eso-pic.sty texmf\tex\latex\eso-pic\showframe.sty</TPM:RunFiles><TPM:TimePackaged>1780842756</TPM:TimePackaged><TPM:MD5>0b9868866ec427ffabcf14dae8b5b7dc</TPM:MD5><TPM:CTAN path="/macros/latex/contrib/eso-pic"/><TPM:Copyright owner="Rolf Niepraschk" year="1998-2025"/><TPM:License type="lppl1.2"/></rdf:Description></rdf:RDF>